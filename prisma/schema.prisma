generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Better Auth Models
model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]

  // Custom fields
  role        String  @default("AGENT") // ADMIN, ACCOUNTANT, LEADER, AGENT, ECOMMERCANT, STOCKISTE, DELIVERY_ASSISTANT, DELIVERY
  // Driver availability flag
  isAvailable Boolean @default(false)

  // Leader <-> Agent self-relation (Téléconseiller -> Leader)
  leaderId String?
  leader   User?   @relation("LeaderToAgents", fields: [leaderId], references: [id], onDelete: SetNull)
  agents   User[]  @relation("LeaderToAgents")

  // Relations
  prospects     Prospect[]
  sales         Sale[]         @relation("AgentToSales")
  userSales     Sale[]         @relation("UserToSales")
  commissions   Commission[]
  notifications Notification[]
  auditLogs     AuditLog[]
  ownedProducts Product[]      @relation("LeaderToProducts")

  // Stockiste relations
  stockisteProducts Product[] @relation("StockisteToProducts")
  stockisteSales    Sale[]    @relation("StockisteToSales")
  leaderSales       Sale[]    @relation("LeaderToSales")

  // Product assignments (vendor access)
  productAssignments ProductAssignment[]

  // Deliveries assigned when user is a driver
  assignedDeliveries Sale[] @relation("DriverToSales")

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

// Application Models

model Prospect {
  id                String   @id @default(cuid())
  fullName          String
  phone             String?
  whatsapp          String?
  address           String?
  city              String?
  source            String?
  interestedProduct String?
  comments          String?
  status            String   @default("NEW") // NEW, CONTACTED, INTERESTED, FOLLOWUP, NEGOTIATION, CONFIRMED, CLIENT, LOST
  agentId           String
  agent             User     @relation(fields: [agentId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  sales Sale[]
}

model Product {
  id              String   @id @default(cuid())
  name            String
  sku             String   @unique
  category        String?
  description     String?
  purchasePrice   Float
  salePrice       Float
  agentCommission Float    @default(0) // Commission Téléconseiller
  ecommercantCommission Float @default(0) // Commission E-commerçant indépendant
  leaderCommission      Float @default(0) // Commission Leader d'équipe
  stockAvailable  Int      @default(0)
  alertThreshold  Int      @default(5)
  isActive        Boolean  @default(true) // Statut activé / désactivé par le stockiste
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Stockiste propriétaire du produit
  stockisteId String?
  stockiste   User?   @relation("StockisteToProducts", fields: [stockisteId], references: [id], onDelete: SetNull)

  // Product ownership legacy / leader specific
  isCommon Boolean @default(true)
  leaderId String?
  leader   User?   @relation("LeaderToProducts", fields: [leaderId], references: [id], onDelete: SetNull)

  // Accessibility rules
  allowAllEcommercants Boolean @default(true)
  allowAllLeaders      Boolean @default(true)

  assignments ProductAssignment[]
  movements   StockMovement[]
  sales       Sale[]
}

model ProductAssignment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  allowed   Boolean  @default(true)
  customAgentCommission       Float?
  customEcommercantCommission Float?
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  type      String // IN, OUT_SALE, OUT_RETURN, OUT_LOSS, OUT_DAMAGE, CORRECTION
  quantity  Int
  cost      Float?
  supplier  String?
  date      DateTime @default(now())
}

model Sale {
  id           String   @id @default(cuid())
  productId    String
  product      Product  @relation(fields: [productId], references: [id])
  quantity     Int
  price        Float
  customerName String
  agentId      String
  agent        User     @relation("AgentToSales", fields: [agentId], references: [id])
  status       String   @default("PENDING") // PENDING, CONFIRMED, SHIPPED, DELIVERED, CANCELLED
  date         DateTime @default(now())
  updatedAt    DateTime @updatedAt

  prospectId String?
  prospect   Prospect? @relation(fields: [prospectId], references: [id])

  // Multi-commissions (Vendeur + Leader si applicable)
  commissions Commission[]

  // Vendeur & Structure
  sellerRole        String  @default("AGENT") // AGENT (Téléconseiller) ou ECOMMERCANT
  leaderId          String?
  leader            User?   @relation("LeaderToSales", fields: [leaderId], references: [id], onDelete: SetNull)
  stockisteId       String?
  stockiste         User?   @relation("StockisteToSales", fields: [stockisteId], references: [id], onDelete: SetNull)

  // Snapshots financiers immuables au moment de la vente
  sellerCommission  Float   @default(0)
  leaderCommission  Float   @default(0)
  stockisteRevenue  Float   @default(0)

  // Delivery fields
  shippingType    String  @default("PICKUP") // PICKUP, DELIVERY
  shippingCity    String? // MORONI, GRANDE_COMORE, ANJOUAN, MOHELI
  shippingAddress String?
  shippingFee     Float   @default(0)
  // Assigned delivery driver
  driverId        String?
  driver          User?   @relation("DriverToSales", fields: [driverId], references: [id], onDelete: SetNull)

  user   User?   @relation("UserToSales", fields: [userId], references: [id])
  userId String?
}

model Commission {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  agentId   String
  agent     User     @relation(fields: [agentId], references: [id])
  role      String   @default("AGENT") // AGENT, ECOMMERCANT, LEADER
  amount    Float
  date      DateTime @default(now())
  status    String   @default("PENDING") // PENDING, PAID
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String
  details   String?
  createdAt DateTime @default(now())
}
